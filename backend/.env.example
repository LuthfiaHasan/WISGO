# ==============================================================================
# WISGO (Rancak.in) - KONFIGURASI ENVIRONMENT BACKEND
# ==============================================================================

# Port server API
PORT=8080

# Environment: development / production / staging
APP_ENV=development

# Kunci rahasia JWT untuk token autentikasi wisatawan
JWT_SECRET=wisgo-rancak-in-secret-key-2026

# Koneksi ke database PostgreSQL fisik
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>?sslmode=disable
# Contoh jika password Anda "admin123":
# DATABASE_URL=postgres://postgres:admin123@localhost:5432/wisgo_db?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wisgo_db?sslmode=disable

